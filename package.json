{
  "name": "ngx-progressbar-demo",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start-mobile": "ng serve --host 0.0.0.0",
    "build": "ng build ngx-progressbar-demo --ssr=false --prerender=false",
    "build-ssr": "ng build ngx-progressbar-demo",
    "watch": "ng build --watch --configuration development",
    "build-lib": "ng build ngx-progressbar",
    "lint-lib": "ng lint ngx-progressbar",
    "test-lib": "ng test ngx-progressbar",
    "test-lib-headless": "ng test ngx-progressbar --watch=false --no-progress --browsers=ChromeHeadless --code-coverage",
    "serve:ssr:ngx-progressbar-demo": "node dist/ngx-progressbar-demo/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "10.0.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.7",
    "@types/node": "^22.14.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "express": "^4.18.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.4",
    "tslib": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
